# Leave empty for the browser's Vite proxy or same-origin deployments.
# Android builds must provide an approved HTTPS Laravel API origin.
VITE_API_ORIGIN=
# Optional outside production. The production landing host automatically links
# to https://app.readirect.org; staging and local builds retain /?entry=tap.
VITE_WEB_APP_ORIGIN=
# Temporary deployment switch. Set to true to use the bundled static Clara image.
VITE_FORCE_STATIC_CLARA=false
