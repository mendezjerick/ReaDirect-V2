APP_NAME=ReaDirect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_FORCE_HTTPS=false
TRUSTED_HOSTS=127.0.0.1,localhost
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=readirect
DB_USERNAME=readirect_app
DB_PASSWORD=
DB_SCHEMA=readirect_v2
DB_SSLMODE=prefer

CACHE_STORE=array
QUEUE_CONNECTION=database
SESSION_DRIVER=array

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=readirect
REVERB_APP_KEY=readirect-local
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost,staging.readirect.org
REVERB_APP_MAX_CONNECTIONS=250
REVERB_APP_MAX_MESSAGE_SIZE=4096
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=120
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_RATE_LIMIT_TERMINATE=true
REVERB_QUEUE_WARNING_DEPTH=25
REVERB_OLDEST_JOB_WARNING_SECONDS=30

DEV_SYSTEM_ADMIN_USERNAME=
DEV_SYSTEM_ADMIN_PASSWORD=
STAFF_SESSION_LIFETIME_HOURS=8
STAFF_SESSION_HEARTBEAT_INTERVAL_SECONDS=30
STAFF_NON_REMEMBERED_SESSION_LEASE_SECONDS=120
STAFF_REMEMBERED_SESSION_LIFETIME_DAYS=30
STAFF_VERIFICATION_CODE_EXPIRY_MINUTES=10
STAFF_VERIFICATION_CODE_RESEND_SECONDS=60
STAFF_VERIFICATION_CODE_MAX_ATTEMPTS=5
STAFF_CODE_REQUESTS_PER_TEN_MINUTES=3
STAFF_CODE_ATTEMPTS_PER_TEN_MINUTES=10

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_USERNAME=
GMAIL_APP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@readirect.local
MAIL_FROM_NAME=ReaDirect
LEARNER_LOGIN_IP_ATTEMPTS_PER_MINUTE=60
LEARNER_LOGIN_IDENTIFIER_ATTEMPTS_PER_MINUTE=5
LEARNER_SESSION_LIFETIME_HOURS=12
LEARNER_SESSION_IDLE_TIMEOUT_MINUTES=60
LEARNER_SESSION_TOUCH_INTERVAL_SECONDS=60
LEARNER_MAX_ACTIVE_SESSIONS=5

ASR_SERVICE_URL=http://127.0.0.1:8001
ASR_SERVICE_TOKEN=
ASR_CONNECT_TIMEOUT_SECONDS=3
ASR_REQUEST_TIMEOUT_SECONDS=180

TTS_SERVICE_URL=http://127.0.0.1:8002
TTS_SERVICE_TOKEN=
TTS_CONNECT_TIMEOUT_SECONDS=3
TTS_REQUEST_TIMEOUT_SECONDS=300
