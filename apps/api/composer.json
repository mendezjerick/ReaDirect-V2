{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "readirect/api",
  "description": "ReaDirect Laravel API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.20",
    "laravel/octane": "^2.17",
    "laravel/reverb": "^1.10",
    "laravel/sanctum": "^4.3",
    "spiral/roadrunner-cli": "^2.7",
    "spiral/roadrunner-http": "^4.1"
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "phpunit/phpunit": "^13.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
